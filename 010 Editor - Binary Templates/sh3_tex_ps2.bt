//------------------------------------------------
//--- 010 Editor Binary Template
//
//      File: sh3_tex_ps2.bt
//   Authors: Laurynas Zubavičius (Sparagas), Rodolfo Nuñez (roocker666)
//   Version: 0.0
//   Purpose: Parse Silent Hill 3 textures for Sony - PlayStation 2.
//  Category: Image
// File Mask: *.tex
//  ID Bytes: FF FF FF FF
//   History: 
//   0.0   2025-01-01 Laurynas Zubavičius : Initial version.
//------------------------------------------------

enum <ubyte> GS_PSM
{
    PSMCT32  = 0x00,
    PSMCT24  = 0x01,
    PSMCT16  = 0x02,
    PSMCT16S = 0x0A,
    PSMT8    = 0x13,
    PSMT4    = 0x14,
    PSMT8H   = 0x1B,
    PSMT4HL  = 0x24,
    PSMT4HH  = 0x2C,
    PSMZ32   = 0x30,
    PSMZ24   = 0x31,
    PSMZ16   = 0x32,
    PSMZ16S  = 0x3A
};

//------------------------------------------------

typedef struct FileHead
{
    int32  magic;
    uint32 version;       // Could be not version
    uint32 contentOffset;
    uint32 lastOffset;    // Goes to last texture, unless it only has one texture. Then it is file size.
    uint32 padding_0x10;  // Could be not padding
    uint32 texCount;
    uint32 padding_0x18;
    uint32 padding_0x1C;
    
    Assert(magic == -1);
} FileHead;

typedef struct TexHead      // sh2gfw_TEX_HEAD
{                           
    int32  texId;           // texture_no
    uint16 unkX;            // x
    uint16 unkY;            // y
    uint16 width;           // w
    uint16 height;          // h
    ubyte  colorBpp;          // color
    ubyte  padSize;         // padbyte
    uint16 unkImportance;   // importance
    uint32 dataSize;        // datasize
    uint32 allSize;         // allsize
    GS_PSM unkSendPsm;      // sendpsm
    GS_PSM drawPsm;         // drawpsm
    ubyte  unkBitShift;     // bitshift
    ubyte  unkTagPoint;     // tagpoint
    ubyte  bitW;            // bitw
    ubyte  bitH;            // bith
    uint16 check <format=hex>; // check
    char   giftag[16];      // ???? Q_WORDDATA giftag; ????

    // Assert(allSize != dataSize + padSize + 48); // 48 = sizeof(TexHead)
    Assert(width == 1 << bitW);
    Assert(height == 1 << bitH);
    Assert(check == 0x9999);
} TexHead;

typedef struct ClutsHead      // sh2gfw_CLUTS_HEAD
{
    uint32 clutsSize;         // clutssize
    uint32 unkGsregsOffset;   // toGSREGS
    uint32 unkRawClutOffset;  // toRawClut
    ubyte  clutCount;         // clutamount
    ubyte  unkTransCluts;     // transcluts
    ubyte  clutW;             // CLUT raster width in texels
    ubyte  clutH;             // CLUT raster height in texels
    ubyte  unkFmt[16];        // fmt[16]
    ubyte  unkTrans[16];      // transparency[16]
    
    Assert(clutCount == 4 || clutCount == 8 || clutCount == 16);
} ClutsHead;

typedef struct PalColumn {
    ubyte palData[64];
} PalColumn;

typedef struct PalBlock {
    PalColumn palColumn[4];
} PalBlock;

typedef struct PalPage
{
    PalBlock palBlock[4];
} PalPage;

//------------------------------------------------

typedef struct Texture {
    TexHead texHead;

    ubyte pad[texHead.allSize - texHead.dataSize - 48];  
    ubyte index[texHead.dataSize];

    if(texHead.colorBpp != 24) {
        ClutsHead clutsHead;
        PalPage palPage[clutsHead.clutCount];
    }

    Printf("clr mode: %d    ", texHead.colorBpp);
    Printf("unkBitShift: %d    ", texHead.unkBitShift);
    Printf("padSize: %d    ", texHead.padSize);
    Printf("actual: %d", texHead.allSize - texHead.dataSize - 48);
    
    if (texHead.padSize != texHead.allSize - texHead.dataSize - 48) {
        Printf(" <-------------\n");
    } else {
        Printf("\n");
    }
} Texture;

//------------------------------------------------

FileHead fileHead;
Texture texture[fileHead.texCount] <optimize=false, warn=false>;

Printf("\n");
