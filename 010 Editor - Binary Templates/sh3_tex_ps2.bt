//------------------------------------------------
//--- 010 Editor Binary Template
//
//      File: sh3_tex_ps2.bt
//   Authors: Laurynas Zubavičius (Sparagas), Rodolfo Nuñez (roocker666)
//   Version: 0.0
//   Purpose: Parse Silent Hill 3 textures for Sony - PlayStation 2.
//  Category: Image
// File Mask: *.tex
//  ID Bytes: FF FF FF FF
//   History: 
//   0.0   2025-01-01 Laurynas Zubavičius : Initial version.
//------------------------------------------------

enum <ubyte> GS_PSM
{
    PSMCT32  = 0x00,
    PSMCT24  = 0x01,
    PSMCT16  = 0x02,
    PSMCT16S = 0x0A,
    PSMT8    = 0x13,
    PSMT4    = 0x14,
    PSMT8H   = 0x1B,
    PSMT4HL  = 0x24,
    PSMT4HH  = 0x2C,
    PSMZ32   = 0x30,
    PSMZ24   = 0x31,
    PSMZ16   = 0x32,
    PSMZ16S  = 0x3A
};

//------------------------------------------------

struct FileHead
{
    int32  magic;
    uint32 ver;
    uint32 content_ofs;
    uint32 content_size;  // could also be an offset, because this is not always points to the end of a file, but sometimes to the last texture.
    uint32 pad;
    uint32 num_tex;
    uint32 pad;
    uint32 pad;
};

struct TexHead              // sh2gfw_TEX_HEAD
{                           
    int32  tex_id;          // texture_no
    uint16 unk_x;           // x
    uint16 unk_y;           // y
    uint16 width;           // w
    uint16 height;          // h
    ubyte  clr_bpp;         // color
    ubyte  pad_len;         // padbyte
    uint16 unk_importance;  // importance
    uint32 data_len;        // datasize
    uint32 all_len;         // allsize
    ubyte  unk_send_psm;    // sendpsm
    GS_PSM draw_psm;        // drawpsm
    ubyte  unk_bit_shift;   // bitshift
    ubyte  unk_tag_point;   // tagpoint
    ubyte  bit_w;           // bitw
    ubyte  bit_h;           // bith
    uint16 check <format=hex>; // check
    char   unk_giftag[16];  // ???? Q_WORDDATA giftag; ????

    // Assert(all_len == data_len + pad_len + 48); // 48 = sizeof(TexHead)
    Assert(width == 1 << bit_w);
    Assert(height == 1 << bit_h);
    Assert(check == 0x9999);
};

struct ClutsHead              // sh2gfw_CLUTS_HEAD
{
    uint32 cluts_len;         // clutssize
    uint32 unk_GSREGS_ofs;    // toGSREGS
    uint32 unk_Raw_clut_ofs;  // toRawClut
    ubyte  clut_count;        // clutamount
    ubyte  unk_trans_cluts;   // transcluts
    ubyte  clw;               // clw CLUT raster width in texels
    ubyte  clh;               // clh CLUT raster height in texels
    ubyte  unk_fmt[16];       // fmt[16]
    ubyte  unk_trans[16];     // transparency[16]
    
    Assert(clut_count == 4 || clut_count == 8 || clut_count == 16);
};

struct PalColumn {
    ubyte pal_data[64];
};

struct PalBlock {
    struct PalColumn pal_column[4];
};

struct PalPage
{
    struct PalBlock pal_block[4];
};

//------------------------------------------------

struct Texture {
    struct TexHead texHead;

    
    // FSkip(texHead.pad_len);
    ubyte pad[texHead.all_len - texHead.data_len - 48];

    // debug
    Printf("clr mode: %d    ", texHead.clr_bpp);
    Printf("unk_bit_shift: %d    ", texHead.unk_bit_shift);
    Printf("pad_len: %d    ", texHead.pad_len);
    Printf("actual: %d", texHead.all_len - texHead.data_len - 48);
    
    if (texHead.pad_len != texHead.all_len - texHead.data_len - 48) {
        Printf(" <-------------\n");
    } else {
        Printf("\n");
    }
    
    ubyte index[texHead.data_len];

    if(texHead.clr_bpp != 24) {
        //FSeek(fileHead.clut_ofs);
        struct ClutsHead cluts_head;
        struct PalPage pal_page[cluts_head.clut_count];
    }
};

//------------------------------------------------

struct FileHead fileHead;
struct Texture  texture[fileHead.num_tex] <optimize=false, warn=false>;

Printf("\n");