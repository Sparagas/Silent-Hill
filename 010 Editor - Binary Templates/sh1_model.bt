//------------------------------------------------
//--- 010 Editor Binary Template
//
//      File: sh1_model.bt
//   Authors: Laurynas Zubavičius (Sparagas)
//   Version: 0.0
//   Purpose: Parse Silent Hill (1) 3D models for Sony - PlayStation. *.ILM are skeletal models, *.IPD are local, and *.PLM are global static models.
//  Category: CAD
// File Mask: *.ILM, *.IPD, *.PLM
//  ID Bytes: 
//   History: 
//   0.0   2025-01-01 Laurynas Zubavičius : Initial version.
//------------------------------------------------


//------------------------------------------------
// In-line Structs
//------------------------------------------------

typedef struct {
    int16 m[3 * 3]; /* 3x3 rotation matrix */
    int16 pad;
    int32 t[3];     /* transfer vector */
} MATRIX;


typedef struct /* 2D short vector */
{
	int16 vx, vy;
} DVECTOR;


/** @brief Extra queue entry data describing where to upload a TIM after reading.
 * See `FsQueueExtra`.
 *
 * @note `tPage` seems to be byte-swapped.
 */
typedef struct _FsImageDesc
{
    uint8 tPage[2];
    uint8 u;
    uint8 v;
    int16 clutX;
    int16 clutY;
} s_FsImageDesc;


/** @brief Smaller `SVECTOR` with padding removed. Used for fixed-point rotations. */
typedef struct _SVECTOR3
{
    int16 vx;
    int16 vy;
    int16 vz;
} SVECTOR3;


/** @brief Polygon normal. */
typedef struct _Normal
{
    int8  nx;
    int8  ny;
    int8  nz;
    uint8 count;
} s_Normal;


/** @brief 8-character string usually used for filenames. Can be compared via the `u32` field. */
typedef union _Filename
{
    char   str[8];
    uint32 u32[2];
} u_Filename;


// Decomp project is not yet updated with UV and faces fields, so I leave decomp one commented out
/*
typedef struct _Primitive
{
    uint16 field_0;
    uint16 field_2;
    uint16 field_4;

    uint8  field_6_0     : 8; // Set to `s_Material::field_E`
    int8   materialIdx   : 7;
    uint8  isTransparent : 1; /** `bool` *

    uint16 field_8;
    uint16 field_A;
    uint8  unk_C[4];  // } Unknown type. `func_8005AC50` reads these as `s32`, but that breaks other funcs which use this struct. `s32` reads might have just been `memcpy`?
    uint8  unk_10[4]; // }
} s_Primitive;
*/

/** @brief Geometry primitive. */
typedef struct _Primitive
{
    uint8  u1;
    uint8  v1;
    uint16 bits;
    uint8  u2;
    uint8  v2; 
    uint8  field_6;           // Set to `s_Material::field_E`
    int8   materialIdx   : 7;
    uint8  isTransparent : 1; /** `bool` */
    uint8  u3;
    uint8  v3;
    uint8  u4;
    uint8  v4;
    uint8  face1;
    uint8  face2;
    uint8  face3;
    uint8  face4;
    uint8  unk_10[4];
} s_Primitive;


/** @brief Mesh data header. */
typedef struct _MeshHeader
{
    uint8  primitiveCount;
    uint8  vertexCount;
    uint8  normalCount;
    uint8  unkCount_3;
    uint32 ptr_primitives                         <format=hex, comment="s_Primitive*">;
    uint32 ptr_verticesXy                         <format=hex, comment="DVECTOR*">;
    uint32 ptr_verticesZ                          <format=hex, comment="int16*">;
    uint32 ptr_normals                            <format=hex, comment="s_Normal*">;
    uint32 ptr_unkPtr_14                          <format=hex, comment="uint8*">;
} s_MeshHeader;


/** @brief Model data header. */
typedef struct _ModelHeader
{
    u_Filename       name;
    uint8            meshCount;
    uint8            vertexOffset;
    uint8            normalOffset;
    uint8            field_B_0 : 1;
    uint8            field_B_1 : 3; // Value used in `func_800571D0` switch.
    uint8            field_B_4 : 2;
    uint8            unk_B_6   : 2;
    uint32           ptr_meshHdrs                 <format=hex, comment="s_MeshHeader*">;
} s_ModelHeader;


/** @brief Model texture. */
typedef struct _Texture
{
    s_FsImageDesc imageDesc;
    u_Filename    name;
    uint32        queueIdx;
    int8          refCount;
} s_Texture;


/** @brief LM file material. */
typedef struct _Material
{
    u_Filename name;
    uint32     ptr_texture                        <format=hex, comment="s_Texture*">;
    uint8      field_C;
    uint8      unk_D[1];
    uint8      field_E;
    uint8      field_F;
    uint16     field_10;
    uint16     field_12;
    union {
        uint8  u8[2];
        uint16 u16;
    } field_14;
    union {
        uint8  u8[2];
        uint16 u16;
    } field_16;
} s_Material;


/** @brief LM file header. */
typedef struct _LmHeader
{
    uint8  magic;    /** Equal to `LM_HEADER_MAGIC` in valid file. */
    Assert(magic == 0x30);
    uint8  version;  /** Equal to `LM_VERSION` in valid file. */
    Assert(version == 6);
    uint8  isLoaded; /** `bool` */
    uint8  materialCount;
    uint32 ptr_materials                          <format=hex, comment="s_Material*">;
    uint8  modelCount;
    uint8   __pad_9[3];
    uint32 ptr_modelHdrs                          <format=hex, comment="s_ModelHeader*">;
    uint32 ptr_modelOrder                         <format=hex, comment="uint8*">;
} s_LmHeader;

//------------------------------------------------

/** @brief IPD file collision subcell split surface. */
 typedef struct _IpdCollSurface
 {
    int16  field_0;           // Relative X. // q7_8 
    int16  baseGroundHeight;  // Base ground height with slope unaccounted for? // q7_8 
    int16  field_4;           // Relative Z. // q7_8 
    uint16 groundType    : 5; /** `e_GroundType` */
    uint16 disableHeight : 3; /** `bool` */
    uint16 field_6_8     : 3; // Causes special collision triggers to behave differently.
                              // The properties should be based upon a value set at
                              // `s_CollisionState::field_A0::s_0::field_8` and it shouldn't
                              // be bigger than 3.
                              // Side note: Maybe the bits number is incorrect as in reality
                              // it gives values up to 7 when it should have been `2` as it would
                              // only ever give a value up to 4, but some dev didn't paid attention
                              // and assigned 3 instead.
    uint16 field_6_11    : 4; /** `bool` | Indicates the surface has a slope? */
    uint16 field_6_15    : 1; // mising in decomp!
    int16  tiltAngleX; // q7_8 
    int16  tiltAngleZ; // q7_8 
} s_IpdCollSurface;


/** @brief IPD file collision subcell containing two split surfaces. */
typedef struct _IpdCollSubcell
{
    int16  field_0_0  : 14; // X. } // q7_8
    uint16 field_0_14 : 2;  // ID Values? } 
    uint16 field_2_0  : 14; // Y. } // q7_8
    uint16 field_2_14 : 2;  // ID Values? } See `func_8006B318` definition for further explanation.
    int16  field_4;         // Z. } // q7_8
    uint8  splitVertexIdx0; // `s_IpdCollisionData::splitVertices` index.
    uint8  splitVertexIdx1; // `s_IpdCollisionData::splitVertices` index.
    uint8  surfaceIdx0;     // `s_IpdCollisionData::surfaces` index.
    uint8  surfaceIdx1;     // `s_IpdCollisionData::surfaces` index.
} s_IpdCollSubcell;


typedef struct _IpdCollSubcellRange
{
    int16 field_0; // Base index into `s_IpdCollisionData::ptr_28`
    int8  field_2; // Another index into `s_IpdCollisionData::ptr_28`.
} s_IpdCollSubcellRange;


typedef struct _IpdCollisionData_18
{
    uint16   groundType    : 5; /** `e_GroundType` */
    uint16   disableHeight : 3; /** `bool` */
    uint16   field_0_8     : 4;
    uint16   field_0_12    : 3;
    uint16   field_0_15    : 1;
    SVECTOR3 offset;            /** Q7.8 */
    uint16   field_8; // q7_8
} s_IpdCollisionData_18;


/** @brief IPD file collision data. */
typedef struct _IpdCollisionData
{
    int32  positionX;
    int32  positionZ;
    uint32 splitVertexCount : 8; /** `splitVertices` size. */
    uint32 surfaceCount     : 8; /** `surfaces` size. */
    uint32 subcellCount     : 8; /** `subcells` size. */
    uint32 field_8_24       : 8; /** `ptr_18` size. */
    uint32 ptr_splitVertices                      <format=hex, comment="SVECTOR3*">;         /** Split subcell vertices. Pairs define a split line. */
    uint32 ptr_surfaces                           <format=hex, comment="s_IpdCollSurface*">; /** Q7.8 | Split subcell surfaces. */
    uint32 ptr_subcells                           <format=hex, comment="s_IpdCollSubcell*">;
    uint32 ptr_18                                 <format=hex, comment="s_IpdCollisionData_18*">;
    int16  subcellSize; // q7_8
    uint8  subcellCountX;
    uint8  subcellCountZ;
    uint32 ptr_subcellRanges                      <format=hex, comment="s_IpdCollSubcellRange*">;
    uint16 field_24; // `field_24/``field_26` defined in ipd2obj but haven't seen used yet, might be size of `ptr_28`/`ptr_2C`.
    uint16 field_26; // `ptr_26` size.
    uint32 ptr_28                                 <format=hex, comment="uint8*">;   // Accessed as array of indices into `subcellCheckIdxs` by `func_8006E53C`.
    uint32 ptr_2C                                 <format=hex, comment="uint8*">;
    uint8  subcellCheckCount;
    uint8  __pad[3];
    uint8  subcellCheckIdxs[256]; // This should be the same size as of the value assigned to
                                  // `s_IpdCollisionData::subcellCount`, but instead is assigned the
                                  // the max number that variable handles, which is 256 (same as a `char`).
} s_IpdCollisionData;


/** @brief IPD file transformed model instance. TODO: Unsure. */
typedef struct _IpdModelInstance
{
    uint32 ptr_modelHdr                           <format=hex, comment="s_ModelHeader*">; // TODO: Stores index at first before being updated to functional pointer.
    MATRIX mat;                                                 // TODO: Base transform matrix?
} s_IpdModelInstance;


/** @brief IPD file model buffer. */
typedef struct _IpdModelBuffer
{
    uint8  modelInstanceCount; /** `modelInstances` size. */
    uint8  field_1;
    uint8  subcellCount;
    int8   __pad_3;
    int16  minX; // } TODO: Cell range or subcell range? redo t
    int16  maxX; // }
    int16  minZ; // }
    int16  maxZ; // }
    uint32 ptr_modelInstances                     <format=hex, comment="s_IpdModelInstance*">;
    uint32 ptr_field_10                           <format=hex, comment="SVECTOR*">; // Q7.8 | Pointer to unknown collision data. TODO: Wrong struct? See `Ipd_ChunkDraw`.
    uint32 ptr_subcellPositions                   <format=hex, comment="SVECTOR*">; /** Q7.8 | XZ positions. TODO: Wrong struct? See `Gfx_ChunkSubcellVisibleCheck`. */
} s_IpdModelBuffer;


/** @brief IPD file model info. */
typedef struct _IpdModelInfo
{
    uint8      isGlobalPlm; // `false` if loaded from inside `IPD`, `true` if loaded from `*_GLB.PLM`.
    int8       __pad_1[3];
    u_Filename name;
    uint32     ptr_modelHdr                       <format=hex, comment="s_ModelHeader*">;
} s_IpdModelInfo;


/** @brief IPD file header. */
typedef struct _IpdHeader
{
    uint8  magic;
    Assert(magic == 0x14);
    uint8  isLoaded; /** `bool` */
    int8   cellX;
    int8   cellY;
    uint32 ptr_lmHdr                              <format=hex, comment="s_LmHeader*">;
    uint8  modelCount;
    uint8  modelBufferCount;
    uint8  modelOrderCount;
    int8   __pad_B[9];
    uint32 ptr_modelInfos                         <format=hex, comment="s_IpdModelInfo*">;
    uint32 ptr_modelBuffers                       <format=hex, comment="s_IpdModelBuffer*">;
    uint8  textureCount; // Should it be `u32`?
                         // "`u8` - Relative pointer to textures list"
                         // "`u32` - Relative pointer to object order"
    uint8  unk_1D[51];   // TODO: Actual texture data array?
    uint32 ptr_modelOrderList                     <format=hex, comment="uint8*">;
    s_IpdCollisionData collisionData              <style=sHeading2>;
} s_IpdHeader;

//------------------------------------------------
// Out-of-line Structs
//------------------------------------------------

typedef struct _ModelBuffers_Data {
    FSeek ( modelBuffers[i].ptr_modelInstances );
    s_IpdModelInstance modelInstances[modelBuffers[i].modelInstanceCount] <style=sSection1>;
    
    FSeek ( modelBuffers[i].ptr_field_10 );
    SVECTOR3 field_10                 <style=sSection2>;
    
    FSeek ( modelBuffers[i].ptr_subcellPositions );
    SVECTOR3 subcellPositions         <style=sSection3>;
} s_ModelBuffers_Data;


typedef struct _ModelBuffers_DataArray {
        for (int i; i < ipdHdr.modelBufferCount; i++)
        {
            s_ModelBuffers_Data modelBuffers_Data;
        }
} s_ModelBuffers_DataArray;


typedef struct _MeshHeader_Data
{
    FSeek ( meshHdrs[j].ptr_primitives );
    s_Primitive primitives [ meshHdrs[j].primitiveCount ] <style=sSection2>;

    FSeek ( meshHdrs[j].ptr_verticesXy );
    DVECTOR verticesXy [ meshHdrs[j].vertexCount ] <style=sSection3>;

    FSeek ( meshHdrs[j].ptr_verticesZ );
    int16 verticesZ [ meshHdrs[j].vertexCount ]   <style=sSection4>;

    FSeek ( meshHdrs[j].ptr_normals );
    s_Normal normals [ meshHdrs[j].normalCount ]  <style=sMarker>;

    FSeek ( meshHdrs[j].ptr_unkPtr_14 );
    ubyte unkIdx [ meshHdrs[j].unkCount_3 ]       <style=sData>;
} s_MeshHeader_Data;


typedef struct _MeshHeader_DataArray
{
    for ( int j = 0; j < lmHdr_Data.modelHdrs[i].meshCount; j++ )
    {
	    FSeek ( meshHdrs[j].ptr_primitives );
        s_MeshHeader_Data meshHdrs_Data;
    };
} s_MeshHeader_DataArray;


typedef struct _ModelHeader_Data
{
    FSeek ( lmHdr_Data.modelHdrs[i].ptr_meshHdrs );
    s_MeshHeader meshHdrs [ lmHdr_Data.modelHdrs[i].meshCount ] <style=sSection1>;

    FSeek ( meshHdrs.ptr_primitives );
    s_MeshHeader_DataArray meshHdrs_DataArray;
} s_ModelHeader_Data;


typedef struct _ModelHeader_DataArray
{
    for (int i = 0; i < lmHdr.modelCount; i++ )
    {
        FSeek ( lmHdr_Data.modelHdrs[i].ptr_meshHdrs );
        s_ModelHeader_Data modelHdrs_Data;
    };
} s_ModelHeader_DataArray;


typedef struct _LmHeader_Data
{
    FSeek ( lmHdr.ptr_materials );
    s_Material materials [ lmHdr.materialCount ]  <style=sHeading2>;

    FSeek ( lmHdr.ptr_modelHdrs );
    s_ModelHeader modelHdrs [ lmHdr.modelCount ]  <style=sHeading3>;

    // for some reason it is always this size of the gap filled with zeroes:
    // FSkip(lmHeader.modelCount);

    FSeek ( lmHdr.ptr_modelOrder );
    uint8 modelsOrder [ lmHdr.modelCount ]        <style=sHeading4>;
} s_LmHeader_Data;

//------------------------------------------------

struct IPD_PART
{
    s_IpdHeader ipdHdr                            <style=sHeading1>;

    FSeek ( ipdHdr.ptr_modelInfos );
    s_IpdModelInfo modelInfos [ ipdHdr.modelCount ] <style=sHeading3>;

    FSeek ( ipdHdr.ptr_modelBuffers );
    s_IpdModelBuffer modelBuffers [ ipdHdr.modelBufferCount ] <style=sHeading4>;

    FSeek ( modelBuffers[0].ptr_modelInstances );
    s_ModelBuffers_DataArray modelBuffers_DataArray;
    
    FSeek ( ipdHdr.ptr_modelOrderList );
    uint8 modelOrderList[ ipdHdr.modelCount ]     <style=sSection4>;
};

struct LM_PART
{
    s_LmHeader      lmHdr                         <style=sHeading1>; 
    s_LmHeader_Data lmHdr_Data;

    FSeek ( lmHdr_Data.modelHdrs.ptr_meshHdrs );
    s_ModelHeader_DataArray modelHdrs_DataArray;
};

//------------------------------------------------
// Main
//------------------------------------------------

if (ReadShort() == 0x14)
{
    IPD_PART ipdPart                              <open=true>;
    OffsetSetStart ( ipdPart.ipdHdr.ptr_lmHdr );
    FSeek(0);
}
LM_PART lmPart                                    <open=true>;
